<script>
  document.addEventListener('DOMContentLoaded', () => {
    let currentLocation = 'kulparkivska';

    // Location switching
    const locationBtns = document.querySelectorAll('.price-location-selector .location-btn');
    locationBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const location = btn.getAttribute('data-location');
        currentLocation = location;

        // Update active location button
        locationBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        showLocationItems(location);

        // Update all buy button URLs
        const buyLinks = document.querySelectorAll('.location-link');
        buyLinks.forEach(link => {
          const url = location === 'kulparkivska'
            ? link.getAttribute('data-url-k')
            : link.getAttribute('data-url-z');

          if (url) {
            link.href = url;
            link.style.pointerEvents = 'auto';
            link.style.opacity = '1';
          } else {
            link.style.pointerEvents = 'none';
            link.style.opacity = '0.5';
          }
        });
      });
    });

    // Trial form: visit date can be from today up to 7 days ahead
    const visitDate = document.querySelector('input[name="visit_date"]');
    if (visitDate) {
      const toLocalDate = (date) => new Date(date.getTime() - date.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
      const today = new Date();
      const inWeek = new Date(today);
      inWeek.setDate(today.getDate() + 7);
      visitDate.min = toLocalDate(today);
      visitDate.max = toLocalDate(inWeek);
    }

    // Mobile menu: toggle the nav and keep aria-expanded in sync
    const burger = document.querySelector('.burger');
    const mainNav = document.getElementById('main-nav');
    burger?.addEventListener('click', () => {
      const open = mainNav.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
    });
    // Close the menu when a link is chosen
    mainNav?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mainNav.classList.remove('open');
        burger?.setAttribute('aria-expanded', 'false');
      });
    });

    // Trial form location: buttons write their value into the hidden field
    const trialLocationBtns = document.querySelectorAll('[data-trial-location]');
    const trialLocationInput = document.querySelector('.trial-location input[name="location"]');
    trialLocationBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        trialLocationBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (trialLocationInput) trialLocationInput.value = btn.getAttribute('data-trial-location');
      });
    });

    // Trial form: validate, then POST JSON to the free-visit endpoint
    const trialForm = document.getElementById('trial-form');
    if (trialForm) {
      const FREE_VISIT_URL = import.meta.env.PUBLIC_FREE_VISIT_URL;
      const submitBtn = trialForm.querySelector('button[type="submit"]');
      const status = trialForm.querySelector('.form-status');
      const fields = trialForm.querySelectorAll('input[name]:not([type="radio"]):not([type="hidden"])');
      const messages = {
        400: 'Перевірте виділені поля.',
        403: 'Цей сайт не може надсилати заявки. Зверніться до студії.',
        409: 'Зверніться до студії, щоб підтвердити запис.',
        429: 'Забагато спроб. Спробуйте пізніше.',
        502: 'Сервіс тимчасово недоступний. Спробуйте пізніше.',
        503: 'Сервіс тимчасово недоступний. Спробуйте пізніше.',
      };

      const isValid = (input) => {
        const value = input.value.trim();
        if (!value) return !input.required;
        if (input.name === 'phone') return /^\+?\d{9,15}$/.test(value.replace(/[\s()-]/g, ''));
        return input.checkValidity();
      };
      const showStatus = (message, isError) => {
        status.textContent = message;
        status.classList.toggle('is-error', isError);
      };
      const markInvalid = (names) => {
        fields.forEach(input => input.classList.toggle('is-invalid', names.includes(input.name)));
      };

      fields.forEach(input => {
        input.addEventListener('input', () => input.classList.remove('is-invalid'));
      });

      trialForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        const invalid = [...fields].filter(input => !isValid(input)).map(input => input.name);
        markInvalid(invalid);
        if (invalid.length) {
          trialForm.querySelector('.is-invalid')?.focus();
          return;
        }

        const field = (name) => trialForm.querySelector(`input[name="${name}"]`).value.trim();
        const selectedLocation = trialForm.querySelector('.trial-location .location-btn.active');
        const body = {
          name: field('name'),
          phone: field('phone'),
          email: field('email'),
          visit_date: field('visit_date'),
          website: '',
          location_id: Number(selectedLocation.dataset.altegioId),
        };

        submitBtn.disabled = true;
        submitBtn.classList.add('is-loading');
        trialForm.classList.add('is-loading');
        showStatus('', false);
        try {
          if (!FREE_VISIT_URL) throw new Error('FREE_VISIT_URL is not set');
          const res = await fetch(FREE_VISIT_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });

          if (res.status === 201) {
            trialForm.reset();
            markInvalid([]);
            showStatus('Дякуємо! Чекаємо вас на тренуванні!', false);
          } else if (res.status === 400) {
            // Mark the fields the server reports; if it doesn't say which, mark all of them
            const data = await res.json().catch(() => ({}));
            const reported = Array.isArray(data.fields) ? data.fields : Object.keys(data.fields ?? data.errors ?? {});
            markInvalid(reported.length ? reported : [...fields].map(input => input.name));
            showStatus(messages[400], true);
          } else {
            showStatus(messages[res.status] ?? 'Щось пішло не так. Спробуйте пізніше.', true);
          }
        } catch {
          showStatus('Немає зв’язку з сервером. Спробуйте пізніше.', true);
        } finally {
          submitBtn.disabled = false;
          submitBtn.classList.remove('is-loading');
          trialForm.classList.remove('is-loading');
        }
      });
    }

    // Price tabs functionality
    const tabButtons = document.querySelectorAll('.price-tab-btn');
    const sections = document.querySelectorAll('.price-section');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tabId = button.getAttribute('data-tab');

        tabButtons.forEach(btn => btn.classList.remove('active'));
        sections.forEach(sec => sec.classList.remove('active'));

        button.classList.add('active');
        document.querySelector(`.price-section[data-tab="${tabId}"]`)?.classList.add('active');
      });
    });

    // Show only subscriptions sold at the selected location; hide tabs left empty
    const showLocationItems = (location) => {
      document.querySelectorAll('.price-card').forEach(card => {
        card.hidden = !card.dataset.locations.split(' ').includes(location);
      });
      let activeHidden = false;
      tabButtons.forEach(btn => {
        const section = document.querySelector(`.price-section[data-tab="${btn.dataset.tab}"]`);
        const hasItems = [...section.querySelectorAll('.price-card')].some(card => !card.hidden);
        btn.hidden = !hasItems;
        if (!hasItems && btn.classList.contains('active')) activeHidden = true;
      });
      if (activeHidden) {
        tabButtons.forEach(btn => { if (!btn.hidden && !btn.classList.contains('active')) btn.click(); });
      }
    };
    showLocationItems(currentLocation);

    // Initialize buy links based on current location
    const buyLinks = document.querySelectorAll('.location-link');
    buyLinks.forEach(link => {
      const url = currentLocation === 'kulparkivska'
        ? link.getAttribute('data-url-k')
        : link.getAttribute('data-url-z');

      if (url) {
        link.href = url;
        link.style.pointerEvents = 'auto';
        link.style.opacity = '1';
      } else {
        link.style.pointerEvents = 'none';
        link.style.opacity = '0.5';
      }
    });
  });
</script>
