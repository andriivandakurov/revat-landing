# Google Places API
# Get API key from: https://console.cloud.google.com/
# Get Place IDs from Google Maps URLs: place_id=...
GOOGLE_PLACES_API_KEY=your-key-here
GOOGLE_PLACE_ID_K=place-id-for-kulparkivska-93
GOOGLE_PLACE_ID_Z=place-id-for-zhovkivska-22

# Altegio API (Business Management API)
# Partner token: Altegio Marketplace → Account settings → Account details
# User token: system user or Business User token (needs loyalty rights at chain level)
ALTEGIO_PARTNER_TOKEN=your-partner-token-here
ALTEGIO_USER_TOKEN=your-user-token-here
ALTEGIO_CHAIN_ID=your-chain-id
ALTEGIO_LOCATION_ID_K=your-kulparkivska-location-id
ALTEGIO_LOCATION_ID_Z=your-zhovkivska-location-id

# Free visit form endpoint (revat-entrance-tracker)
# Local: http://localhost:3000/public/free-visit
# Production: https://revat-entrance-tracker.onrender.com/public/free-visit
PUBLIC_FREE_VISIT_URL=your-free-visit-endpoint
